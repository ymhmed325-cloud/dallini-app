# اختياري: إن لم يُضبط يعمل الخادم بذاكرة مؤقتة
DATABASE_URL=postgres://user:password@host:5432/dallini
PORT=10000

# --- أمان (اضبطها في الإنتاج) ---
# NODE_ENV=production            # يعطّل وضع التجربة (devCode) و DEMO_FLOW نهائياً
# RESET_DEMO_MODE=false          # لا يُفعَّل إلا للتجربة المحلية (=true)
# DEMO_FLOW=false                # يسمح للعميل بمحاكاة تقدّم الطلب (للتجربة فقط)
# DB_SSL_STRICT=true             # تحقق من شهادة قاعدة البيانات إن كان مزوّدك يدعمها

# --- البريد الإلكتروني (رموز استرجاع كلمة المرور) ---
# اختر مزوّداً واحداً (واجهة HTTP، بدون SMTP):
# RESEND_API_KEY=...             # https://resend.com
# BREVO_API_KEY=...              # https://brevo.com
# EMAIL_FROM=دلّيني <no-reply@yourdomain.com>   # لازم يكون نطاقاً موثّقاً عند المزوّد
